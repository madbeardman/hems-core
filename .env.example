# Credentials belong in ignored .env or the process environment.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HEMS_HOST=127.0.0.1
HEMS_PORT=3001

# User-confirmed PV defaults; optional overrides:
# HEMS_FIT_PV_ENTITY=sensor.solis_s6_gr1p_active_power
# HEMS_HYBRID_PV1_ENTITY=sensor.solis_s6_eh1p_pv_power_1
# HEMS_HYBRID_PV2_ENTITY=sensor.solis_s6_eh1p_pv_power_2
# Set true only after confirming physical sources when overriding defaults:
# HEMS_PV_MAPPINGS_CONFIRMED=true

# Grid mappings confirmed by user; household remains unmapped.
HEMS_GRID_IMPORT_ENTITY=sensor.garage_solis_s6_eh1p_grid_import_power
HEMS_GRID_EXPORT_ENTITY=sensor.garage_solis_s6_eh1p_grid_export_power
HEMS_HOUSEHOLD_ENTITY=sensor.solis_s6_eh1p_household_load_power
# Set the user-confirmed Octopus current-day event ID locally.
# Meter/account identifiers belong in .env, not this example.
HEMS_AGILE_RATES_ENTITY=
HEMS_GRID_NET_ENTITY=sensor.solis_s6_eh1p_grid_power_net

# User-confirmed Forecast.Solar daily totals: FIT SW, hybrid NW, hybrid W.
HEMS_FORECAST_MAPPINGS_CONFIRMED=true
HEMS_FORECAST_FIT_TODAY_ENTITY=sensor.energy_production_today
HEMS_FORECAST_FIT_TOMORROW_ENTITY=sensor.energy_production_tomorrow
HEMS_FORECAST_HYBRID1_TODAY_ENTITY=sensor.energy_production_today_2
HEMS_FORECAST_HYBRID1_TOMORROW_ENTITY=sensor.energy_production_tomorrow_2
HEMS_FORECAST_HYBRID2_TODAY_ENTITY=sensor.energy_production_today_3
HEMS_FORECAST_HYBRID2_TOMORROW_ENTITY=sensor.energy_production_tomorrow_3

# Hybrid inverter AC output; household balance semantics still need confirmation.
HEMS_HYBRID_AC_ENTITY=sensor.solis_s6_eh1p_active_power

# Set the separately confirmed Octopus next-day event ID locally.
HEMS_AGILE_NEXT_DAY_RATES_ENTITY=

# Step 6: local SQLite history (relative to process working directory).
# Prefer an absolute writable path for a service, e.g. /var/lib/hems-core/history.sqlite3.
HEMS_DB_PATH=data/history.sqlite3
# Allowed 60..3600 seconds; prices and forecast revisions polled every >=5 minutes.
HEMS_HISTORY_INTERVAL_SECONDS=60
# Allowed 1..3650 days; applies to samples, forecast/price snapshots and prices.
HEMS_HISTORY_RETENTION_DAYS=30

# Octopus costs: set meter-specific sensor IDs only in ignored local .env.
HEMS_ELECTRICITY_TODAY_COST_ENTITY=
HEMS_ELECTRICITY_TODAY_CONSUMPTION_ENTITY=
HEMS_ELECTRICITY_STANDING_CHARGE_ENTITY=
HEMS_ELECTRICITY_PREVIOUS_COST_ENTITY=
HEMS_ELECTRICITY_PREVIOUS_CONSUMPTION_ENTITY=
HEMS_ELECTRICITY_METER_DEMAND_ENTITY=
HEMS_GAS_TODAY_COST_ENTITY=
HEMS_GAS_TODAY_CONSUMPTION_ENTITY=
HEMS_GAS_STANDING_CHARGE_ENTITY=
HEMS_GAS_PREVIOUS_COST_ENTITY=
HEMS_GAS_PREVIOUS_CONSUMPTION_ENTITY=

# Step 7 advisory modelling assumptions; confirm with actual battery configuration.
HEMS_MODEL_NOMINAL_KWH=10.24
HEMS_MODEL_USABLE_KWH=9.728
HEMS_MODEL_RESERVE_PERCENT=10
# Measure the essential CCTV/network baseload locally. Zero means no extra floor;
# whole-home history still includes those loads. No away-load subtraction.
HEMS_MODEL_ESSENTIAL_BASELOAD_W=0
# Optional ISO weekday schedule (1=Monday .. 5=Friday), e.g. 1,3.
# Applied to historical dates too; leave empty if occupancy varies/unknown.
HEMS_MODEL_WFH_DAYS=
# Optional explicit London dates for variable occupancy; overrides weekday schedule.
# HEMS_MODEL_OCCUPANCY_DATES={"2026-10-30":"wfh","2026-10-31":"away"}
